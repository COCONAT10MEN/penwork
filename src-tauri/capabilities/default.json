{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-message",
    "allow-get-accent-color",
    "allow-take-pending-open",
    "allow-read-app-file",
    "allow-write-app-file",
    "allow-open-deck",
    "allow-set-deck-slides",
    "allow-close-deck"
  ],
  "local": true
}
