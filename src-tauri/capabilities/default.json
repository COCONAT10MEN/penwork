{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-message",
    "allow-get-accent-color",
    "allow-take-pending-open",
    "allow-read-app-file",
    "allow-write-app-file",
    "allow-open-deck",
    "allow-set-deck-slides",
    "allow-close-deck",
    "allow-create-deck-session",
    "allow-add-deck-asset",
    "allow-read-html-deck",
    "allow-write-draft",
    "allow-existing-paths",
    "allow-read-logo-file",
    "allow-write-thumb",
    "allow-read-thumb",
    "allow-delete-thumb",
    "allow-capture-view"
  ],
  "local": true
}
