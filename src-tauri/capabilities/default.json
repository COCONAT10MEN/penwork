{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "allow-get-accent-color",
    "allow-take-pending-open",
    "allow-read-app-file",
    "allow-write-app-file",
    "allow-open-deck",
    "allow-set-deck-slides",
    "allow-close-deck",
    "allow-create-deck-session",
    "allow-add-deck-asset",
    "allow-write-draft",
    "allow-existing-paths",
    "allow-read-logo-file",
    "allow-write-thumb",
    "allow-read-thumb",
    "allow-delete-thumb",
    "allow-capture-view",
    "allow-export-toolbar",
    "allow-read-toolbar-file",
    "allow-read-ink",
    "allow-write-ink",
    "allow-save-deck",
    "allow-write-recovery",
    "allow-list-recovery",
    "allow-delete-recovery",
    "allow-open-recovery",
    "allow-delete-draft",
    "allow-copy-slide-assets",
    "allow-paste-slide-assets",
    "allow-delete-ink"
  ],
  "local": true
}
