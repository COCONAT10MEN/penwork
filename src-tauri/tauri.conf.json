{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Penwork",
  "version": "0.1.0",
  "identifier": "com.penwork.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Penwork",
        "width": 1200,
        "height": 650,
        "minWidth": 960,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost; frame-src http://penwork-deck.localhost penwork-deck:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/open-with.nsh"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "pwpptx"
        ],
        "name": "Penwork deck",
        "description": "Penwork presentation",
        "role": "Editor",
        "mimeType": "application/vnd.penwork.deck"
      }
    ]
  }
}
